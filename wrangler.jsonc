{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multigatelitenpl",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/auth/*", "/integrasi/npl/*"],
    "not_found_handling": "single-page-application"
  }
}
